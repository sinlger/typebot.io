# Make sure to change this to your own random string of 32 characters (https://docs.typebot.io/self-hosting/deploy/docker#2-add-the-required-configuration)
ENCRYPTION_SECRET=do+UspMmB/rewbX2K/rskFmtgGSSZ8Ta

DATABASE_URL=postgresql://postgres:typebot@typebot-db:5432/typebot

NODE_OPTIONS=--no-node-snapshot

NEXTAUTH_URL=
NEXT_PUBLIC_VIEWER_URL=

ADMIN_EMAIL=
# 新工作区的默认套餐。设为 UNLIMITED 可让新用户免费使用全部功能（不限对话、席位、自定义域名等）。
# 可选值: FREE / STARTER / PRO / LIFETIME / OFFERED / CUSTOM / UNLIMITED / ENTERPRISE
DEFAULT_WORKSPACE_PLAN=
# For more configuration options check out: https://docs.typebot.io/self-hosting/configuration

# Comma-separated block IDs to hide from the flow editor's left sidebar.
# Case-sensitive; values are the raw enum / forge id strings. ID sources:
#   packages/blocks/bubbles/src/constants.ts        e.g. text image video embed audio
#   packages/blocks/inputs/src/constants.ts         e.g. "text input" "payment input" "choice input"
#   packages/blocks/logic/src/constants.ts          e.g. "Set variable" Condition webhook Code "AB test"
#   packages/blocks/integrations/src/constants.ts   e.g. "Google Sheets" Webhook Email Zapier Pabbly
#   packages/events/src/constants.ts                command reply invalidReply
#   packages/forge/blocks/*/                        e.g. openai anthropic mistral dify-ai
# Naming collisions:
#   "openai"  → Forge OpenAI block;  "OpenAI"  → legacy Integration block.
#   "webhook" → Logic Webhook block; "Webhook" → Integration HTTP request block.

# 隐藏的块元素
# 用法：把不想在「流程编辑器左侧 Integrations 分组」展示的模块 ID 用英文逗号分隔写在下面。
# 改完必须重启 dev 进程（NEXT_PUBLIC_* 不会热更新）。
# 区分大小写、点和横杠都要原样照抄；写错会静默失效不报错。
#
# ===== Integrations 分组完整 ID 清单 =====
#
# -- 原生集成（IntegrationBlockType，packages/blocks/integrations/src/constants.ts）
#   显示名 Google Sheets       →  Google Sheets
#   显示名 OpenAI(legacy)      →  OpenAI         # 老版,目前默认就被项目隐藏,写了无效果
#   显示名 Google Analytics    →  Google Analytics
#   显示名 HTTP request        →  Webhook
#   显示名 Send email          →  Email
#   显示名 Zapier              →  Zapier
#   显示名 Make.com            →  Make.com
#   显示名 Pabbly Connect      →  Pabbly
#   显示名 Chatwoot            →  Chatwoot
#   显示名 Pixel               →  Pixel
#
# -- Forge 集成（forgedBlocks，packages/forge/blocks/*）
#   显示名 OpenAI              →  openai
#   显示名 Cal.com             →  cal-com
#   显示名 ChatNode            →  chat-node
#   显示名 QR code             →  qr-code
#   显示名 Dify.AI             →  dify-ai
#   显示名 Mistral             →  mistral
#   显示名 ElevenLabs          →  elevenlabs
#   显示名 Anthropic           →  anthropic
#   显示名 Together            →  together-ai
#   显示名 OpenRouter          →  open-router
#   显示名 NocoDB              →  nocodb
#   显示名 Segment             →  segment
#   显示名 Groq                →  groq
#   显示名 Zendesk             →  zendesk
#   显示名 Posthog             →  posthog
#   显示名 Perplexity          →  perplexity
#   显示名 DeepSeek            →  deepseek
#   显示名 Blink               →  blink
#   显示名 Gmail               →  gmail
#
# 重名提醒：openai = 新版 Forge 块；OpenAI = 老版 native，已被项目默认隐藏。
#          webhook(小写)=Logic 里的 Webhook 块；Webhook(首字母大写)=Integrations 里的 HTTP request。
#
# 其它分组（Bubbles/Inputs/Logic/Events）的 ID 见 .env.example。
# Text input	text input
# Number input	number input
# Email input	email input
# Website (URL)	url input
# Date input	date input
# Time input	time input
# Phone number input	phone number input
# Choice (Buttons)	choice input
# Picture choice	picture choice input
# Payment	payment input
# Rating	rating input
# File input	file input
# Cards	cards
# NEXT_PUBLIC_HIDDEN_BLOCKS=openai,Zapier,Make.com,Pabbly,Chatwoot,Pixel,cal-com,open-router,blink,anthropic
